[Unit]
Description=TDXS
After=runtime-init.service
Requires=runtime-init.service 
Wants=tdxs.socket

[Service]
User=tdxs
Group=tdx
WorkingDirectory=/home/tdxs
Type=notify
# CAP_DAC_OVERRIDE lets tdxs (running as the unprivileged tdxs user) create a
# report entry under /sys/kernel/config/tsm/report and write its root-owned
# `inblob` attribute file. The native TDX (gcp/bare-metal) issuer generates
# quotes through this configfs-tsm interface; the dir and its kernel-created
# attribute files are root-owned, so without this cap mkdir/inblob fail with
# EACCES. Harmless for the azure issuer (which uses the tdx-group-owned vTPM
# devices instead).
AmbientCapabilities=CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_DAC_OVERRIDE
ExecStart=/usr/bin/tdxs \
    --config /etc/tdxs/config.yaml
Restart=on-failure

[Install]
WantedBy=default.target
