[Unit]
Description=TDXS
After=runtime-init.service
Requires=runtime-init.service 
Wants=tdxs.socket

[Service]
User=tdxs
Group=tdx
WorkingDirectory=/home/tdxs
Type=notify
# NOTE: the native (tdx) issuer additionally needs CAP_DAC_OVERRIDE to drive the
# root-owned configfs-tsm interface. That capability is added by a drop-in only
# for the tdx issuer (see render-config.sh); the azure issuer does not get it.
ExecStart=/usr/bin/tdxs \
    --config /etc/tdxs/config.yaml
Restart=on-failure

[Install]
WantedBy=default.target
