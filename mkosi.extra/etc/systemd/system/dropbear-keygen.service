[Unit]
Description=Generate dropbear SSH host keys
Documentation=man:dropbearkey(1)
DefaultDependencies=no
After=local-fs.target
Before=dropbear.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/mkdir -p /etc/dropbear
ExecStart=/bin/sh -c '[ -f /etc/dropbear/dropbear_ed25519_host_key ] || /usr/bin/dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key'
ExecStart=/bin/sh -c '[ -f /etc/dropbear/dropbear_ecdsa_host_key ]   || /usr/bin/dropbearkey -t ecdsa   -f /etc/dropbear/dropbear_ecdsa_host_key'
ExecStart=/bin/sh -c '[ -f /etc/dropbear/dropbear_rsa_host_key ]     || /usr/bin/dropbearkey -t rsa     -f /etc/dropbear/dropbear_rsa_host_key'

[Install]
WantedBy=multi-user.target
