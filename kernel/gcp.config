# GCP-specific kernel config snippet (appended to kernel-yocto.config for the
# `gcp` profile only — see mkosi.profiles/gcp/mkosi.conf).
#
# GCP's C3 machine family — the only Intel-TDX-capable family on GCE — presents
# a Google Virtual NIC (gVNIC) and does NOT support virtio-net. Without the gve
# driver the guest has no network interface at all, so network-setup.service
# (and everything depending on it: runtime-init/8080, reth-tdx, tdxs) never
# starts. Build it in (=y) so it's available at early boot without module load.
CONFIG_NET_VENDOR_GOOGLE=y
CONFIG_GVE=y

# GCP attaches disks as NVMe. In a TDX guest, NVMe allocates DMA descriptor
# pages with GFP_ATOMIC, which must come from a coherent pool of decrypted
# (unencrypted) memory. Without DMA_COHERENT_POOL the kernel WARNs in
# dma_direct_alloc and NVMe write IO hangs (cryptsetup luksFormat stuck in D
# state). DMA_COHERENT_POOL has no prompt and is only select-ed by
# AMD_MEM_ENCRYPT, so enable that (deps: X86_64, CPU_SUP_AMD, EFI_STUB — all
# already set; harmless on Intel hardware). Azure uses SCSI-over-Hyper-V and
# never hit this. INTEL_TDX_GUEST alone does not pull in the coherent pool.
CONFIG_AMD_MEM_ENCRYPT=y
