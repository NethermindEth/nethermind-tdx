[Unit]
Description=Raiko2 TDX Bootstrap Display
Documentation=https://docs.surge.wtf/
After=raiko2.service
Requires=raiko2.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/nethermind-surge/.env
# Wait until the HTTP server is reachable, then dump bootstrap data to journal
# and a stable on-disk path that operators can read with `cat`.
ExecStart=/bin/sh -c 'for i in $(seq 1 60); do \
    if curl -fsS http://127.0.0.1:8080/health >/dev/null 2>&1; then break; fi; \
    sleep 1; \
  done; \
  curl -fsS http://127.0.0.1:8080/v3/proof/tdx/bootstrap \
    | tee /home/raiko2/bootstrap.json \
    | sed "s/.*/raiko2 bootstrap: &/"'

User=raiko2
Group=tdx

[Install]
WantedBy=default.target
