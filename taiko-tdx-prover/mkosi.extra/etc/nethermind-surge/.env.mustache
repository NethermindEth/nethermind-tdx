############################### DEFAULT #####################################

# L1
L1_CHAINID={{tdx_prover.l1_chainid}}

L1_ENDPOINT_HTTP={{tdx_prover.l1_rpc}}
L1_ENDPOINT_WS={{tdx_prover.l1_rpc_ws}}
L1_BEACON_HTTP={{tdx_prover.l1_beacon_rpc}}
# Blob fallback endpoint used by taiko-client when beacon blob sidecars are unavailable.
# Must support GET /blobs/{versioned_hash} or anvil_getBlobByHash.
BLOB_SERVER={{tdx_prover.l1_rpc}}
SHASTA_INBOX={{tdx_prover.shasta_inbox}}
PACAYA_INBOX={{tdx_prover.pacaya_inbox}}

# On-chain Shasta verifier address. reth-tdx pins this at startup so it rejects
# proof requests claimed for a different deployment.
SHASTA_VERIFIER={{tdx_prover.shasta_verifier}}

# L2
L2_CHAINID={{tdx_prover.l2_chainid}}
TAIKO_ANCHOR={{tdx_prover.l2_contract}}

L2_ENDPOINT_HTTP=http://localhost:8547
L2_ENDPOINT_WS=ws://localhost:8548
L2_AUTH_HTTP=http://localhost:8552

# Exposed ports
L2_METRICS_PORT=8018
L2_HTTP_PORT=8547
L2_WS_PORT=8548
L2_ENGINE_API_PORT=8552
L2_NETWORK_DISCOVERY_PORT=30313



############################### NETHERMIND CLIENT ###############################
EL_LOG_LEVEL=debug

############################### RETH-TDX ########################################
RUST_LOG=info
