#!/bin/bash
set -euxo pipefail

declare -A groups=(
    ["eth"]="nethermind-surge,taiko-client"
    ["tdx"]="tdxs,reth-tdx,nethermind-surge"
)

services=(
    "network-setup.service"
    "openntpd.service"
    "logrotate.service"
    "runtime-init.service"
    "dropbear-keygen.service"
    "dropbear.service"
    "nethermind-surge.service"
    "taiko-client.service"
    "reth-tdx.service"
    "reth-tdx-bootstrap.service"
    "tdxs.service"
    "tdxs.socket"
    # "nethermind.service"
    # "lighthouse.service"
)

for group in "${!groups[@]}"; do
    mkosi-chroot groupadd -r "$group"
    
    IFS=',' read -ra users <<< "${groups[$group]}"
    for user in "${users[@]}"; do
        # Create user if doesn't exist, otherwise add to group
        if mkosi-chroot id "$user" &>/dev/null; then
            mkosi-chroot usermod -a -G "$group" "$user"
        else
            mkosi-chroot useradd -r -s /bin/false -G "$group" -m "$user"
        fi
    done
done

mkosi-chroot chown reth-tdx:reth-tdx /home/reth-tdx

mkdir "$BUILDROOT/etc/systemd/system/minimal.target.wants"
for service in "${services[@]}"; do
    mkosi-chroot systemctl enable "$service"
    ln -sf "/etc/systemd/system/$service" "$BUILDROOT/etc/systemd/system/minimal.target.wants/"
done

# Strip the dropbear host keys generated by the package's postinst. They
# are fresh randomness on every build and otherwise change PCR[11].
# dropbear-keygen.service regenerates them on first boot (to the tmpfs
# /etc/dropbear), before dropbear.service starts. authorized_keys, if
# present, is preserved.
rm -f "$BUILDROOT"/etc/dropbear/dropbear_*_host_key*

# Don't reserve port 22 and allow dropbear to take it
mkosi-chroot systemctl disable ssh.service ssh.socket
mkosi-chroot systemctl mask ssh.service ssh.socket

# NOTE: do NOT bake an SSH public key into the image here. The prover's SSH
# key is injected at runtime via the runtime-init webserver on :8080. The old
# `if [ -f id_ed25519.pub ]` block baked a key into /etc/dropbear and
# /root/.ssh whenever that git-ignored file happened to exist in the build
# tree — which (a) broke reproducibility (CI's clean checkout has no such
# file, a local dev tree does → different authorized_keys → different
# initrd → different PCRs/RTMRs) and (b) embedded a dev key into the
# measured boot. Runtime injection is the only supported path.

# # Lock the root account
# mkosi-chroot passwd -l root

